            {
              "port": 53,
              "protocol": "TCP"
            }
          ]
        },
        {
          "ports": [
            {
              "port": 3128,
              "protocol": "TCP"
            }
          ],
          "to": [
            {
              "ipBlock": {
                "cidr": "192.0.2.0/24"
              }
            }
          ]
        },
        {
          "to": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "monitoring"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 3000,
              "protocol": "TCP"
            }
          ]
        }
      ],
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "monitoring"
                }
              }
            }
          ],
          "ports": [
            {
              "port": 8080,
              "protocol": "TCP"
            }
          ]
        }
      ]
    }
  },
