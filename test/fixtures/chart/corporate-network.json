[
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "tellagen-proxy-policy",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "data": {
      "policy.yaml": "datasourceUIDs:\n- prom-prod\n- loki-prod\nlogs:\n  maxLines: 10\nquery:\n  maxListPerRun: 30\n  maxPerRun: 20\n  maxTimeout: 30s\n"
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "tellagen-proxy",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "spec": {
      "replicas": 2,
      "revisionHistoryLimit": 3,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "tellagen-proxy",
          "app.kubernetes.io/instance": "tellagen-proxy"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "tellagen-proxy",
            "app.kubernetes.io/instance": "tellagen-proxy"
          },
          "annotations": {
            "checksum/policy": "63898872bd481504f6bc65d86a4e063c1ca73ab7d3113ca99736746537d0afb2"
          }
        },
        "spec": {
          "serviceAccountName": "tellagen-proxy",
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsNonRoot": true,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "terminationGracePeriodSeconds": 30,
          "containers": [
            {
              "name": "tellagen-proxy",
              "image": "ghcr.io/tellagen/tellagen-proxy:0.0.0",
              "imagePullPolicy": "IfNotPresent",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "env": [
                {
                  "name": "TELLAGEN_PROXY_TOKEN_FILE",
                  "value": "/etc/tellagen-proxy/secrets/tellagen-proxy-token"
                },
                {
                  "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE",
                  "value": "/etc/tellagen-proxy/secrets/grafana-service-account-token"
                },
                {
                  "name": "GRAFANA_URL",
                  "value": "http://grafana.monitoring.svc:3000"
                },
                {
                  "name": "GRAFANA_PUBLIC_URL",
                  "value": "https://grafana.example.com"
                },
                {
                  "name": "TELLAGEN_INSTALL_METHOD",
                  "value": "helm"
                },
                {
                  "name": "HTTPS_PROXY",
                  "value": "http://proxy.corp.example:3128"
                },
                {
                  "name": "NO_PROXY",
                  "value": ".corp.example,10.0.0.0/8,.svc,.cluster.local"
                },
                {
                  "name": "TELLAGEN_CA_FILE",
                  "value": "/etc/tellagen-proxy/ca/ca.crt"
                },
                {
                  "name": "GRAFANA_CA_FILE",
                  "value": "/etc/tellagen-proxy/ca/ca.crt"
                },
                {
                  "name": "TELLAGEN_POLICY_FILE",
                  "value": "/etc/tellagen-proxy/policy/policy.yaml"
                }
              ],
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080,
                  "protocol": "TCP"
                }
              ],
              "startupProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 5,
                "failureThreshold": 30
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 20,
                "failureThreshold": 3
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "http"
                },
                "periodSeconds": 10,
                "failureThreshold": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "name": "secrets",
                  "mountPath": "/etc/tellagen-proxy/secrets",
                  "readOnly": true
                },
                {
                  "name": "ca",
                  "mountPath": "/etc/tellagen-proxy/ca",
                  "readOnly": true
                },
                {
                  "name": "policy",
                  "mountPath": "/etc/tellagen-proxy/policy",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "secrets",
              "secret": {
                "secretName": "tellagen-proxy",
                "defaultMode": 288
              }
            },
            {
              "name": "ca",
              "configMap": {
                "name": "corp-ca",
                "defaultMode": 292
              }
            },
            {
              "name": "policy",
              "configMap": {
                "name": "tellagen-proxy-policy",
                "defaultMode": 292
              }
            }
          ],
          "affinity": {
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "weight": 100,
                  "podAffinityTerm": {
                    "topologyKey": "kubernetes.io/hostname",
                    "labelSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/name": "tellagen-proxy",
                        "app.kubernetes.io/instance": "tellagen-proxy"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
