[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "tellagen-proxy",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "spec": {
      "replicas": 2,
      "revisionHistoryLimit": 3,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "tellagen-proxy",
          "app.kubernetes.io/instance": "tellagen-proxy"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/name": "tellagen-proxy",
            "app.kubernetes.io/instance": "tellagen-proxy"
          }
        },
        "spec": {
          "serviceAccountName": "tellagen-proxy",
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 65532,
            "runAsGroup": 65532,
            "fsGroup": 65532,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "terminationGracePeriodSeconds": 30,
          "containers": [
            {
              "name": "tellagen-proxy",
              "image": "ghcr.io/tellagen/tellagen-proxy:0.0.0",
              "imagePullPolicy": "IfNotPresent",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "env": [
                {
                  "name": "TELLAGEN_PROXY_TOKEN_FILE",
                  "value": "/etc/tellagen-proxy/secrets/tellagen-proxy-token"
                },
                {
                  "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE",
                  "value": "/etc/tellagen-proxy/secrets/grafana-service-account-token"
                },
                {
                  "name": "GRAFANA_URL",
                  "value": "https://grafana.example.com"
                },
                {
                  "name": "GRAFANA_ORG_ID",
                  "value": "2"
                },
                {
                  "name": "GRAFANA_ALLOWED_DATASOURCE_UIDS",
                  "value": "prom-prod,loki-prod"
                },
                {
                  "name": "TELLAGEN_INSTALL_METHOD",
                  "value": "helm"
                }
              ],
              "ports": [
                {
                  "name": "http",
                  "containerPort": 8080,
                  "protocol": "TCP"
                }
              ],
              "startupProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 5,
                "failureThreshold": 30
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": "http"
                },
                "periodSeconds": 20,
                "failureThreshold": 3
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": "http"
                },
                "periodSeconds": 10,
                "failureThreshold": 3
              },
              "resources": {
                "limits": {
                  "cpu": "500m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                }
              },
              "volumeMounts": [
                {
                  "name": "secrets",
                  "mountPath": "/etc/tellagen-proxy/secrets",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "secrets",
              "secret": {
                "secretName": "tellagen-proxy",
                "defaultMode": 288
              }
            }
          ],
          "affinity": {
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "weight": 100,
                  "podAffinityTerm": {
                    "topologyKey": "kubernetes.io/hostname",
                    "labelSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/name": "tellagen-proxy",
                        "app.kubernetes.io/instance": "tellagen-proxy"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "tellagen-proxy-doctor",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      },
      "annotations": {
        "helm.sh/hook": "test",
        "helm.sh/hook-delete-policy": "before-hook-creation,hook-succeeded"
      }
    },
    "spec": {
      "restartPolicy": "Never",
      "serviceAccountName": "tellagen-proxy",
      "automountServiceAccountToken": false,
      "securityContext": {
        "runAsNonRoot": true,
        "runAsUser": 65532,
        "runAsGroup": 65532,
        "fsGroup": 65532,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "containers": [
        {
          "name": "doctor",
          "image": "ghcr.io/tellagen/tellagen-proxy:0.0.0",
          "imagePullPolicy": "IfNotPresent",
          "args": [
            "doctor"
          ],
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "runAsNonRoot": true,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            }
          },
          "env": [
            {
              "name": "TELLAGEN_PROXY_TOKEN_FILE",
              "value": "/etc/tellagen-proxy/secrets/tellagen-proxy-token"
            },
            {
              "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN_FILE",
              "value": "/etc/tellagen-proxy/secrets/grafana-service-account-token"
            },
            {
              "name": "GRAFANA_URL",
              "value": "https://grafana.example.com"
            },
            {
              "name": "GRAFANA_ORG_ID",
              "value": "2"
            },
            {
              "name": "GRAFANA_ALLOWED_DATASOURCE_UIDS",
              "value": "prom-prod,loki-prod"
            },
            {
              "name": "TELLAGEN_INSTALL_METHOD",
              "value": "helm"
            }
          ],
          "resources": {
            "limits": {
              "cpu": "500m",
              "memory": "256Mi"
            },
            "requests": {
              "cpu": "50m",
              "memory": "64Mi"
            }
          },
          "volumeMounts": [
            {
              "name": "secrets",
              "mountPath": "/etc/tellagen-proxy/secrets",
              "readOnly": true
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "secrets",
          "secret": {
            "secretName": "tellagen-proxy",
            "defaultMode": 288
          }
        }
      ]
    }
  },
  {
    "apiVersion": "policy/v1",
    "kind": "PodDisruptionBudget",
    "metadata": {
      "name": "tellagen-proxy",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "spec": {
      "minAvailable": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "tellagen-proxy",
          "app.kubernetes.io/instance": "tellagen-proxy"
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "ServiceAccount",
    "metadata": {
      "name": "tellagen-proxy",
      "labels": {
        "helm.sh/chart": "tellagen-proxy-0.0.0",
        "app.kubernetes.io/name": "tellagen-proxy",
        "app.kubernetes.io/instance": "tellagen-proxy",
        "app.kubernetes.io/version": "0.0.0",
        "app.kubernetes.io/managed-by": "Helm"
      }
    },
    "automountServiceAccountToken": false
  }
]
