{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tellagen-proxy values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "tellagen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": { "type": "string" },
        "url": { "type": "string", "pattern": "^(https?://.+)?$" },
        "labels": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$" },
          "additionalProperties": { "type": "string", "pattern": "^[^,=]{1,128}$" }
        }
      }
    },
    "grafana": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^(https?://.+)?$" },
        "publicUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "orgId": { "type": ["string", "integer"], "pattern": "^[0-9]*$", "minimum": 1 },
        "token": { "type": "string" },
        "allowedDatasourceUids": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^,\\s]+$" } }
      }
    },
    "existingSecret": { "type": "string" },
    "secretKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tellagenToken": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
        "grafanaToken": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" }
      }
    },
    "secretFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tellagenToken": { "type": "string", "pattern": "^(/.+)?$" },
        "grafanaToken": { "type": "string", "pattern": "^(/.+)?$" }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpsProxy": { "type": "string" },
        "noProxy": { "type": "string" },
        "grafanaHttpsProxy": { "type": "string" }
      }
    },
    "caBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "policy": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "vaultAuth": { "type": "boolean" }
      }
    },
    "openshift": { "type": "boolean" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "tellagen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": { "type": "array", "items": { "type": "string" } },
            "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": { "type": "array", "items": { "type": "object" } },
            "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    }
  }
}
